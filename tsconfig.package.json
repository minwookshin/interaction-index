{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "incremental": false,
    "noEmit": false,
    "outDir": "./dist/package/types",
    "rootDir": "./src",
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/components/ui/**/*.ts",
    "src/components/ui/**/*.tsx",
    "src/lib/**/*.ts",
    "src/tokens/generated.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
