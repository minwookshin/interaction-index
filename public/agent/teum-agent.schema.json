{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teum.minwookshin.com/agent/teum-agent.schema.json",
  "title": "Teum agent contract",
  "type": "object",
  "required": ["schemaVersion", "version", "system", "components", "recipes", "selectionRules", "forbiddenRules"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "generatedBy": { "type": "string", "minLength": 1 },
    "system": {
      "type": "object",
      "required": ["product", "principles", "workflow", "qualityGates"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "product": { "const": "Teum" },
        "principles": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "workflow": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "qualityGates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "description", "registryItem", "registryDependencies", "packageDependencies"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "type": { "enum": ["registry:ui", "registry:component", "registry:block", "registry:lib"] },
          "description": { "type": "string" },
          "registryItem": { "type": "string", "pattern": "^@teum/" },
          "registryDependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "packageDependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "useWhen": { "type": "string", "minLength": 1 },
          "avoidWhen": { "type": "string", "minLength": 1 },
          "states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "keyboard": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "quality": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "title", "domain", "intent", "signals", "registryItem", "modulePath", "exportName", "components", "state", "rules", "forbidden"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "domain": { "enum": ["data", "analytics", "product"] },
          "intent": { "type": "string", "minLength": 1 },
          "signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "registryItem": { "enum": ["teum-data", "teum-analytics", "teum-product-patterns"] },
          "modulePath": { "type": "string", "minLength": 1 },
          "exportName": { "type": "string", "minLength": 1 },
          "components": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "state": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "forbidden": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "selectionRules": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["task", "choose", "insteadOf", "when", "rejectWhen"],
        "properties": {
          "task": { "type": "string", "minLength": 1 },
          "choose": { "type": "string", "minLength": 1 },
          "insteadOf": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "when": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "rejectWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "forbiddenRules": {
      "type": "array",
      "minItems": 12,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
