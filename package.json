{
  "name": "interaction-index",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browsers": "playwright test",
    "test:browsers:report": "playwright show-report",
    "test:visual": "playwright test tests/browser/visual-regression.spec.ts --project=chromium",
    "test:a11y": "playwright test tests/browser/accessibility.spec.ts --project=chromium",
    "test:pilot": "playwright test tests/browser/product-pilot.spec.ts --project=chromium",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "measure": "node scripts/measure-performance.mjs",
    "configure:publication": "node scripts/configure-publication.mjs",
    "build:registry:style": "node scripts/build-registry-style.mjs",
    "build:registry": "npm run build:registry:style && shadcn build",
    "test:registry": "node scripts/verify-registry.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "quality": "npm run test && npm run build:registry && npm run test:registry && npm run build && npm run test:sites && npm run measure"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.18.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minwookshin/interaction-index.git"
  },
  "bugs": {
    "url": "https://github.com/minwookshin/interaction-index/issues"
  },
  "homepage": "https://minwookshin.github.io/interaction-index"
}
